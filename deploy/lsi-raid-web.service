[Unit]
Description=LSI MegaRAID Monitor Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/lsi-raid-monitor
Environment=LSI_DATA_DIR=/opt/lsi-raid-monitor/data
Environment=LSI_WEB_HOST=0.0.0.0
Environment=LSI_WEB_PORT=5200
Environment=LSI_COOKIE_SECURE=0
ExecStart=/usr/bin/python3 -m waitress --host=${LSI_WEB_HOST} --port=${LSI_WEB_PORT} web_server:app
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/lsi-raid-monitor/data
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
