[Unit]
Description=DataMax-LSI 存储管理系统
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 按实际安装路径修改下面三行
WorkingDirectory=/opt/lsi-raid-monitor
Environment=LSI_DATA_DIR=/opt/lsi-raid-monitor/data
Environment=LSI_WEB_HOST=0.0.0.0
Environment=LSI_WEB_PORT=5200
Environment=LSI_COOKIE_SECURE=0

# 用装了 waitress 的那个解释器。本机 Python 与实际部署环境不一致时，
# 系统自带的 /usr/bin/python3 往往没有 waitress，服务会起不来。
ExecStart=/opt/anaconda3/bin/python3 -m waitress --host=0.0.0.0 --port=5200 web_server:app

Restart=always
RestartSec=5
TimeoutStopSec=20
StandardOutput=append:/var/log/datamax-lsi.log
StandardError=append:/var/log/datamax-lsi.log

# 以 root 运行：需要读写 /dev 下的 megaraid 设备、调用 storcli，
# 并经 libpam 校验系统账号。
#
# 以下加固项刻意不启用，原因写在这里，免得后来者"顺手加上"又把功能弄坏：
#   NoNewPrivileges=true  —— 程序内部用 `sudo storcli` 执行阵列命令，
#                            该选项会让 sudo 直接失败，阵列操作全部不可用。
#   ProtectSystem=full    —— storcli 需要访问 /dev 与 /sys。
#   ProtectHome=true      —— 项目可能就装在 /root 下。
# 加固的前提是不破坏功能；一个跑不起来的安全配置没有意义。

[Install]
WantedBy=multi-user.target
