LSI_DATA_DIR=/opt/lsi-raid-monitor/data
LSI_WEB_HOST=0.0.0.0
LSI_WEB_PORT=5200
LSI_COOKIE_SECURE=0
STORCLI_PATH=/usr/local/bin/storcli64
SMARTCTL_PATH=/usr/sbin/smartctl
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

